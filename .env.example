# Copy to .env.local and fill in. Never commit real keys.

# Public URL of the app. Paystack sends customers back to <APP_URL>/billing/return.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Solana
# devnet while testing, mainnet-beta in production.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# RPC used by the browser wallet. Leave empty to use the public endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=
# RPC used by the server to detect payments. Use a dedicated provider in
# production (Helius, Triton, QuickNode…); the public endpoints rate-limit hard.
SOLANA_RPC_URL=

# ---------------------------------------------------------------- Crypto payments
# The wallet that receives SOL and USDC. Use an address you control, ideally a
# hardware wallet or multisig. Only the public address goes here.
MERCHANT_WALLET=
# USDC mint. Defaults to the official mint for the network above; set it only
# for a custom cluster.
USDC_MINT=
# Minutes a customer has to send the payment (default 30).
CRYPTO_PAYMENT_WINDOW_MIN=30
# "confirmed" (default, a few seconds) or "finalized" (about 15 seconds, safest).
SOLANA_PAYMENT_COMMITMENT=confirmed
# Shared secret for POST /api/billing/crypto/sweep, which a scheduler should
# call every minute or two. Generate with: openssl rand -hex 32
BILLING_CRON_SECRET=

# ---------------------------------------------------------------- Paystack
# From dashboard.paystack.com → Settings → API Keys & Webhooks.
# Use sk_test_… while testing. Webhook URL: <APP_URL>/api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
# Currency your Paystack account settles in: NGN, GHS, ZAR, KES or USD.
PAYSTACK_CURRENCY=NGN
# Units of PAYSTACK_CURRENCY per 1 USD. Plan prices are set in USD.
# Not needed when PAYSTACK_CURRENCY=USD.
PAYSTACK_USD_RATE=1550

# ---------------------------------------------------------------- Storage
# Orders are kept in this JSON file (default .data/billing.json). Fine for a
# single server; move to a database before running several instances.
BILLING_DATA_FILE=
